{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adp:risk-review:risk-flow-relation-v1",
  "title": "ADP risk flow relation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["risk_flow_schema_version", "risks", "compatibility"],
  "properties": {
    "risk_flow_schema_version": {"const": "1.0.0"},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "migration_error_code"],
      "properties": {
        "strategy": {"const": "preserve-unmapped"},
        "migration_error_code": {"const": "ADP-RISK-FLOW-MIGRATION-REQUIRED"}
      }
    }
  },
  "$defs": {
    "stableId": {"type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_path", "field", "source_fingerprint"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/stableId"},
        "artifact_path": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "source_fingerprint": {"type": "string", "pattern": "sha256:[0-9a-f]{64}"}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_id", "lifecycle", "relation_state", "observed_at", "terminal_at", "baseline_revision", "related_plan_item_ids", "related_flow_edge_ids", "rule_id", "sources"],
      "properties": {
        "risk_id": {"$ref": "#/$defs/stableId"},
        "lifecycle": {"enum": ["open", "monitoring", "mitigating", "accepted", "closed", "cancelled"]},
        "relation_state": {"enum": ["watching", "at-risk", "blocked", "resolved", "not-applicable"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "terminal_at": {"type": ["string", "null"], "format": "date-time"},
        "baseline_revision": {"type": "integer", "minimum": 1},
        "related_plan_item_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
        "related_flow_edge_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
        "rule_id": {"$ref": "#/$defs/stableId"},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
      }
    }
  }
}
